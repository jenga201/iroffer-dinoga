#!/command/with-contenv bash
# shellcheck shell=bash

# shellcheck source=/dev/null
source /etc/s6-overlay/scripts/bash-functions

umask "${UMASK}"

log_inf "[DINOGA] Starting dinoga (config: ${CONFIG_DIR}/dinoga.config)."

exec s6-setuidgid hotio "${APP_DIR}/dinoga" --config "${CONFIG_DIR}/dinoga.config"