#!/command/with-contenv bash
# shellcheck shell=bash

# shellcheck source=/dev/null
source /etc/s6-overlay/scripts/bash-functions

umask "${UMASK}"

# Only meaningful when the VPN is enabled. Runs before init-wireguard so the
# picked region is in place before hotio connects (a clean, fresh connect with
# correct endpoint routing).
[[ "${VPN_ENABLED}" == "true" ]] || exit 0

region=$(python3 "${APP_DIR}/pia-regions.py" pick)
if [[ -z "${region}" ]]; then
    log_wrn "[DINOGA-REGION] No candidate region determined; using hotio default."
    exit 0
fi

# init-wireguard sources /run/s6/container_environment at start; override here.
printf '%s\n' "${region}" > /run/s6/container_environment/VPN_PIA_PREFERRED_REGION

# Persist the choice for the recorder and clear a stale forwarded port so the
# recorder waits for a fresh grant from service-pia.
printf '%s\n' "${region}" > /run/dinoga-current-region
rm -f "${CONFIG_DIR}/wireguard/forwarded_port"

log_inf "[DINOGA-REGION] Selected region [${region}] for this boot."