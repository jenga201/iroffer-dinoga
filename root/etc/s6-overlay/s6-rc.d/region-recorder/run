#!/command/with-contenv bash
# shellcheck shell=bash

# shellcheck source=/dev/null
source /etc/s6-overlay/scripts/bash-functions

umask "${UMASK}"

if [[ "${VPN_ENABLED}" != "true" ]]; then
    # VPN disabled: region selection is irrelevant; stay out of the way.
    while :; do sleep 3600; done
fi

region=$(cat /run/dinoga-current-region 2>/dev/null || true)
state="${DINOGA_REGION_STATE:-${CONFIG_DIR}/pia-regions-state.json}"

# --- IRC probe target: first network block of dinoga.config. ---
irc_host="irc.rizon.net"; irc_port=9999
if [[ -f "${CONFIG_DIR}/dinoga.config" ]]; then
    line=$(grep -m1 '^[[:space:]]*server ' "${CONFIG_DIR}/dinoga.config" 2>/dev/null)
    if [[ -n "${line}" ]]; then
        irc_host=$(awk '{print $2}' <<< "${line}")
        p=$(awk '{print $3}' <<< "${line}"); [[ -n "${p}" ]] && irc_port="${p}"
    fi
fi

want_pf=false
[[ "${VPN_AUTO_PORT_FORWARD}" == "true" ]] && want_pf=true
timeout=${VPN_PIA_REGION_TIMEOUT:-180}

# --- Wait for the forwarded port (service-pia writes this on a grant). ---
pf_ok=true
if [[ "${want_pf}" == "true" ]]; then
    pf_ok=false
    deadline=$((SECONDS + timeout))
    while (( SECONDS < deadline )); do
        if [[ -s "${CONFIG_DIR}/wireguard/forwarded_port" ]]; then
            pf_ok=true
            break
        fi
        sleep 5
    done
fi

# --- IRC acceptance probe (retry on "unknown", stop on a ban). ---
irc_ok=false
irc_reason="irc-timeout"
if [[ "${pf_ok}" == "true" ]]; then
    deadline=$((SECONDS + timeout))
    while (( SECONDS < deadline )); do
        python3 "${APP_DIR}/irc-probe.py" "${irc_host}" "${irc_port}"
        rc=$?
        if [[ ${rc} -eq 0 ]]; then
            irc_ok=true
            break
        fi
        if [[ ${rc} -eq 1 ]]; then
            irc_reason="irc-banned"
            break
        fi
        sleep 10
    done
fi

mark_region() {
    local subcmd="${1}"
    [[ -z "${region}" || -z "${subcmd}" ]] && return 0
    shift
    python3 "${APP_DIR}/pia-regions.py" "${subcmd}" "${region}" "$@" 2>/dev/null || true
}

if [[ "${pf_ok}" == "true" && "${irc_ok}" == "true" ]]; then
    log_inf "[DINOGA-REGION] Region [${region}] accepted (port-forward + IRC); staying up."
    mark_region mark-good
    while :; do sleep 3600; done
fi

reason="no-port-forward"
[[ "${pf_ok}" == "true" ]] && reason="${irc_reason}"
log_wrn "[DINOGA-REGION] Region [${region}] rejected (${reason}); restarting to try the next candidate."
mark_region mark-bad "${reason}"

exhausted=$(jq -r '.exhausted // false' "${state}" 2>/dev/null)
backoff=${VPN_PIA_REGION_BACKOFF:-20}
[[ "${exhausted}" == "true" ]] && backoff=${VPN_PIA_REGION_EXHAUSTED_BACKOFF:-1800}

log_inf "[DINOGA-REGION] Backing off ${backoff}s before a clean restart."
sleep "${backoff}"
s6-linux-init-shutdown -r now 2>/dev/null || kill -9 1
# Shutdown should have taken over; idle as a safety net if it did not.
while :; do sleep 3600; done