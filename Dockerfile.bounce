# syntax=docker/dockerfile:1

FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/bounce ./cmd/bounce

FROM alpine:3.20
RUN apk add --no-cache ca-certificates \
    && addgroup -S bounce \
    && adduser -S -G bounce bounce
WORKDIR /home/bounce
COPY --from=build /out/bounce /usr/local/bin/bounce
USER bounce
ENTRYPOINT ["bounce"]