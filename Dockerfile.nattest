# syntax=docker/dockerfile:1

FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/nattest ./cmd/nattest

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/nattest /usr/local/bin/nattest
ENTRYPOINT ["nattest"]