# Dinoga canonical configuration.
#
# Run without Docker:   dinoga --config /path/to/dinoga.config
# Run with Docker:      mount this as /config/dinoga.config (see .env.example);
#                       put the serve-mode/VPN deltas in .env instead of here.
#
# Lines beginning with '#' are comments. One `network { ... }` block per IRC
# server. `--print-config` prints the full directive reference; `--hash-password`
# prints an admin-password hash. Unknown directives are ignored.

network {
  server irc.rizon.net 9999
  user_nick dinoga              # per-instance: each bot in #frog needs a distinct nick
  channel #frog
  connectionmethod ssl          # direct | ssl
}

# Directory scanned into the XDCC/SXDCC pack list.
filedir /data

# Single shared control port: SXDCC control+data, SDCC admin chat, and the
# HTTP packlist all ride this port.
control_port 30000

# Serve XDCC over TLS 1.3 (also enables SDCC admin chat on the control port).
sxdcc_enable yes

# ---------------------------------------------------------------------------
# Serve mode — the only thing that differs between the open and VPN instances.
#   Docker: set these in .env (IROFFER_USENATIP / IROFFER_XDCC_ENABLE /
#           IROFFER_TCPRANGESTART/LIMIT) so the config file stays identical.
#   Bare binary: uncomment the block you want here.
# ---------------------------------------------------------------------------
# --- Open instance: classic XDCC + SXDCC, ports reachable ---
# usenatip 2.31.76.192          # public IP advertised for DCC/SXDCC
# xdcc_enable yes
# tcprangestart 30001           # classic DCC ports (KEEP DISJOINT from control_port)
# tcprangelimit 30010

# --- VPN instance: SXDCC only (single forwarded port) ---
# xdcc_enable no                # classic XDCC/DCC disabled

# ---------------------------------------------------------------------------
# Transfers / limits (optional; defaults shown)
# ---------------------------------------------------------------------------
# slotsmax 3                    # concurrent transfers
# queuesize 100                 # queued transfers
# idlequeuesize 25              # idle queue
# transfermaxspeed 0            # per-transfer cap, KB/s (0 = unlimited)
# overallmaxspeed 0             # global cap, KB/s (0 = unlimited)
# passive_dcc no                # reverse DCC (bot connects out)

# ---------------------------------------------------------------------------
# Admin / web (optional)
# ---------------------------------------------------------------------------
# adminpass <secret>            # admin password for SDCC chat (plaintext, or a
#                               #   SHA-256 hash from `dinoga --hash-password`)
# http_port 0                   # separate HTTP port (0 = disabled; the packlist
#                               #   is also served on control_port as /packlist.txt)

# ---------------------------------------------------------------------------
# Misc (optional)
# ---------------------------------------------------------------------------
# uploaddir <dir>               # receive incoming DCC SEND uploads here
# uploadhost <mask>             # hostmask allowed to upload (empty = all)
# headline <msg>                # announced on channel join
# periodicmsg <msg>             # periodic channel message
# periodicmsg_time 0            # seconds between periodic messages
# autoaddann no                 # announce newly-added packs on rescan
# statefile <path>              # JSON state file (packs/resume)
# logfile <path>