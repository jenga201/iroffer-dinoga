# Dinoga configuration (canonical — all bot parameters).
#
#   docker:      mount as /config/dinoga.config; per-instance deltas go in .env
#                (IROFFER_* / IROFFER_NETWORK_* override this file).
#   bare binary: dinoga --config /path/to/dinoga.config
#
# An upstream iroffer.config dropped here is migrated on start: renamed *.bak
# and rewritten as a dinoga.config. `--print-config` prints this surface;
# `--hash-password` prints an admin-password hash. Unknown directives are ignored.

# --- IRC networks (one block per server) --------------------------------------
network {
  name rizon                     # optional; labels the network in logs
  server irc.rizon.net 9999
  user_nick dinoga               # per-instance: each bot in #frog needs a nick
  channel #frog                  # optional " -key <k>" and " -noannounce"
  connectionmethod ssl           # direct | ssl
  # sasl_username <account>      # optional SASL (defaults to user_nick)
  # sasl_password <secret>
}

# --- files served (XDCC/SXDCC pack list) --------------------------------------
filedir /data
# autoadd_time 0                 # rescan interval, seconds (0 = off)
# autoaddann no                  # announce newly-added packs on rescan
# noduplicatefiles no            # drop files with duplicate name+size
# adddir_exclude *.tmp           # skip matching globs (repeatable)
# adddir_match *.mkv             # only include matching globs
# adddir_min_size 0              # skip smaller files (bytes)
# nat_sort no                    # natural (strnatcmp) listing order
# nocrc32 no                     # suppress CRC32 in xdcc info
# nomd5sum no                    # suppress MD5 in xdcc info
# xdcclistfile <path>            # write a plain-text pack list after each scan
# xdccxmlfile <path>             # write an XML pack list after each scan

# --- ports / serve mode -------------------------------------------------------
control_port 30000               # SXDCC+SDCC+HTTP packlist on this one port
sxdcc_enable yes                 # serve XDCC over TLS 1.3 (+ SDCC admin chat)
xdcc_enable yes                  # no = disable classic cleartext XDCC/DCC

# classic DCC transfer ports (only used when xdcc_enable yes).
# KEEP DISJOINT from control_port; publish this range for the open instance.
tcprangestart 30001
tcprangelimit 30010

# usenatip <public-ip>           # public IP advertised for DCC/SXDCC. REQUIRED
#                                 # for the open instance; the VPN instance lets
#                                 # the VPN watcher discover it.
# passive_dcc no                 # reverse DCC (bot connects out)
# tcp_nodelay no                 # TCP_NODELAY on transfer/chat sockets
# tcp_buffer_size 0              # SO_SNDBUF/SO_RCVBUF in KB (0 = OS default)
# sxdcc_cert /config/certs/sxdcc-cert.pem
# sxdcc_key /config/certs/sxdcc-key.pem

# --- transfers / queue / limits (defaults shown) -------------------------------
# slotsmax 3
# queuesize 100
# idlequeuesize 50
# maxtransfersperperson 0
# maxqueueitemsperperson 0
# maxidlequeuedperperson 0
# transfermaxspeed 0             # per-transfer cap, KB/s (0 = unlimited)
# overallmaxspeed 0              # global cap, KB/s (0 = unlimited)

# --- access control -----------------------------------------------------------
# xdcc_allow <mask>              # allow-list hostmask (empty = allow all)
# xdcc_deny <mask>               # deny-list (wins)
# uploadhost <mask>              # hostmask allowed to upload (empty = all)
# restrictlist no                # only channel members may xdcc list/info
# restrictsend no                # only channel members may xdcc send/batch
# need_voice no                  # + require voice or higher (needs restrictsend)
# need_level 0                   # + require 1=voice 2=halfop 3=op
# flood_protection_rate 6        # max XDCC cmds per user per window (0 = off)
# autoignore_time 10             # seconds a flooding user is ignored

# --- admin / web --------------------------------------------------------------
# adminpass <secret>             # SDCC chat password (plaintext or SHA-256 hash)
# owner_nick <nick>              # answered by the SXDCC OWNER command
# http_port 0                    # separate HTTP interface (0 = disabled; the
#                                 # packlist is also served on control_port)

# --- uploads ------------------------------------------------------------------
# uploaddir <dir>                # receive incoming DCC SEND uploads here
# uploadmaxsize 0                # incoming upload cap, bytes (0 = unlimited)
# uploadminspace 0               # min free MiB to accept an upload

# --- announcements ------------------------------------------------------------
# headline <msg>                 # announced on channel join
# periodicmsg <msg>              # periodic channel message
# periodicmsg_time 0             # seconds between periodic messages
# announce_size no               # include size in the autoaddann announce
# announce_date no               # include date in the autoaddann announce

# --- logging / persistence ----------------------------------------------------
# statefile <path>               # JSON state (packs/resume)
# old_statefile <path>           # rolling backup of the previous statefile
# logfile <path>
# logrotate never                # never/daily/weekly/monthly/<N> hours
# expire_logfiles 0              # days to retain rotated logs (0 = keep)
# logmessages no                 # log incoming PRIVMSG lines
# lognotices no                  # log incoming NOTICE lines
# logstats yes                   # periodic status line
# status_time_dcc_chat 120       # status/logstats interval, seconds
# reconnect_delay 30             # seconds between reconnect attempts