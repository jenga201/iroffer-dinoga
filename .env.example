##############################################################################
## dinoga docker environment
##
## dinoga extends hotio/base (noblevpn amd64): a single container that can sit
## behind a VPN with one port-forward (e.g. PIA). The Go bot is compiled inside
## the Docker build. The bot's config lives at /config/dinoga.config and migrates
## a dropped-in iroffer.config/sample.config automatically (old file is renamed
## to .bak).
##
## Two groups of variables:
##   1. IROFFER_*        the bot's own directives. Any value set here OVERRIDES
##                       the same directive in /config/dinoga.config (env wins),
##                       and is INFO-logged at bot start. Unset = keep the file.
##                       Multi-value directives take ";;"-separated values.
##   2. hotio docker only  container/VPN/s6 values consumed by hotio/base. These
##                       do NOT belong in dinoga.config (the bot won't load
##                       them); keep them in their own section below.
##############################################################################

# ==============================================================================
# hotio docker only  (container / VPN / s6-overlay — NOT dinoga.config directives)
# ==============================================================================

# Image and container names.
IMAGE_NAME=ghcr.io/jenga201/dinoga
IMAGE_TAG=noblevpn
CONTAINER_NAME=dinoga

# Run-time user/group and timezone (hotio convention; affects file ownership).
PUID=1000
PGID=1000
TZ=Etc/UTC
UMASK=002

# Host directories mounted into the container.
CONFIG_DIR=./config
DATA_DIR=./files

# Control port. In VPN mode this is reached via the forwarded port (hotio
# redirects it with VPN_PORT_REDIRECTS); with VPN disabled it is published
# directly. Keep it in sync with IROFFER_CONTROL_PORT below.
CONTROL_PORT=30000

# --- VPN (hotio/base noblevpn) ---
# VPN_ENABLED=true                 # enable wireguard VPN
# VPN_CONF=wg0
# VPN_PROVIDER=pia                 # pia | proton | generic
# VPN_AUTO_PORT_FORWARD=true        # request a forwarded port from the provider (PIA/proton)
# VPN_PORT_REDIRECTS=30000/tcp      # redirect the forwarded port to dinoga's control port.
#                                   # hotio format is <port>/<tcp|udp>; dinoga is TCP-only.
# VPN_LAN_NETWORK=
# VPN_LAN_LEAK_ENABLED=false
# VPN_EXPOSE_PORTS_ON_LAN=
# VPN_HEALTHCHECK_ENABLED=false
# VPN_NAMESERVERS=
# VPN_INTERFACE_PREFIXES=
# VPN_PIA_USER=
# VPN_PIA_PASS=
# VPN_PIA_PREFERRED_REGION=
# VPN_PIA_DIP_TOKEN=               # empty (or "no") = no dedicated IP
# VPN_PIA_PORT_FORWARD_PERSIST=false

# --- PIA region selection (auto-iterate until one works) ---
# dinoga persists region success/failure to ${DINOGA_REGION_STATE} and, on a
# boot whose VPN exits are all rejected (no port-forward / IRC-banned), does a
# clean self-restart with the next candidate. Selection order:
#   VPN_PIA_PREFERRED_REGION (if not recently failed) -> last good -> untried
#   -> stale failures. Set VPN_PIA_PREFERRED_REGION to pin a region and still
# fall through to others when it fails.
# DINOGA_REGION_STATE=/config/pia-regions-state.json  # where history is saved
# VPN_PIA_REGION_COOLDOWN=21600     # seconds a failed region is avoided before retry
# VPN_PIA_REGION_TIMEOUT=180        # seconds to wait for port-forward + IRC on a boot
# VPN_PIA_REGION_BACKOFF=20         # seconds to wait before self-restarting (normal)
# VPN_PIA_REGION_EXHAUSTED_BACKOFF=1800  # backoff once all regions are recently failed

# ==============================================================================
# dinoga bot  (IROFFER_* directives — override /config/dinoga.config)
# ==============================================================================

# --- DCC / SXDCC / SDCC (single shared control port) ---
# IROFFER_USENATIP=2.31.76.192      # public IP advertised for DCC/SXDCC
# IROFFER_CONTROL_PORT=30000        # single shared control port (TLS + web packlist)
# IROFFER_TCPRANGESTART=30000       # used when control_port is 0
# IROFFER_TCPRANGELIMIT=30001
# IROFFER_PASSIVE_DCC=no            # yes|no  reverse DCC (bot connects out)
# IROFFER_TCP_NODELAY=no            # yes = set TCP_NODELAY on transfer/chat sockets
# IROFFER_TCP_BUFFER_SIZE=0         # SO_SNDBUF/SO_RCVBUF in KB (0 = OS default)
# IROFFER_SXDCC_ENABLE=yes          # serve XDCC over TLS 1.3
# IROFFER_XDCC_ENABLE=yes           # no = disable classic cleartext XDCC/DCC (single-port/VPN)
# IROFFER_SXDCC_CERT=/config/certs/sxdcc-cert.pem
# IROFFER_SXDCC_KEY=/config/certs/sxdcc-key.pem

# --- files served ---
# IROFFER_FILEDIR=/data
# IROFFER_AUTOADD_TIME=60
# IROFFER_SLOTSMAX=3
# IROFFER_QUEUESIZE=100
# IROFFER_IDLEQUEUESIZE=25
# IROFFER_MAXTRANSFERSPERPERSON=0
# IROFFER_MAXQUEUEITEMSPERPERSON=0
# IROFFER_MAXIDLEQUEUEDPERPERSON=0
# IROFFER_TRANSFERMAXSPEED=0        # KB/s (0 = unlimited)
# IROFFER_OVERALLMAXSPEED=0         # KB/s (0 = unlimited)
# IROFFER_NODUPLICATEFILES=no       # yes|no
# IROFFER_ADDDIR_EXCLUDE=*.tmp;;*.part
# IROFFER_ADDDIR_MATCH=
# IROFFER_ADDDIR_MIN_SIZE=0
# IROFFER_AUTOADDANN=no            # yes = announce newly-added packs on rescan

# --- access control (hostmasks, ";;"-separated) ---
# IROFFER_XDCC_ALLOW=
# IROFFER_XDCC_DENY=
# IROFFER_FLOOD_PROTECTION_RATE=6  # max XDCC cmds per user per window (0 = off)
# IROFFER_AUTOIGNORE_TIME=10       # seconds a flooding user is ignored
# IROFFER_UPLOADHOST=              # hostmask allowed to upload (";;"-separated; empty = all)
# IROFFER_RESTRICTLIST=no          # yes = only channel members may xdcc list/info
# IROFFER_RESTRICTSEND=no          # yes = only channel members may xdcc send/batch
# IROFFER_NEED_VOICE=no            # + require voice or higher (needs restrictsend)
# IROFFER_NEED_LEVEL=0             # + require level 1=voice 2=halfop 3=op (needs restrictsend)

# --- admin / web ---
# IROFFER_ADMINPASS=                # admin password (SDCC chat)
# IROFFER_HTTP_PORT=0              # separate HTTP interface (0 = disabled)
# IROFFER_HTTP_ALLOW=              # CIDR allow-list (";;"-separated)
# IROFFER_HTTP_DENY=

# --- uploads / misc ---
# IROFFER_UPLOADDIR=
# IROFFER_UPLOADMAXSIZE=0
# IROFFER_UPLOADMINSPACE=0         # min free MiB on uploaddir (0 = none)
# IROFFER_HEADLINE=
# IROFFER_PERIODICMSG=
# IROFFER_PERIODICMSG_TIME=0
# IROFFER_ANNOUNCE_SIZE=no         # include size in autoaddann announce
# IROFFER_ANNOUNCE_DATE=no         # include date in autoaddann announce
# IROFFER_STATEFILE=
# IROFFER_OLD_STATEFILE=           # rolling backup of the previous statefile
# IROFFER_STATUS_TIME_DCC_CHAT=120 # status/logstats interval in seconds
# IROFFER_LOGFILE=
# IROFFER_LOGROTATE=              # never/daily/weekly/monthly/<N> hours (default: never)
# IROFFER_EXPIRE_LOGFILES=0       # days to keep rotated logs (0 = keep forever)
# IROFFER_LOGMESSAGES=            # yes = log incoming PRIVMSG lines
# IROFFER_LOGNOTICES=             # yes = log incoming NOTICE lines
# IROFFER_LOGFILE_MESSAGES=       # separate PRIVMSG transcript file (default: logfile)
# IROFFER_LOGFILE_NOTICES=        # separate NOTICE transcript file (default: logfile)
# IROFFER_LOGSTATS=yes            # periodic status line into the logfile