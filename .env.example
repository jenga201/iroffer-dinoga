##############################################################################
## dinoga docker environment (copy to .env)
##
## Split of responsibilities:
##   /config/dinoga.config   ALL of the bot's parameters (see sample.config).
##                           Same file for every instance.
##   .env (this file)        VPN/container variables, PLUS any IROFFER_* value
##                           that differs per instance (env wins over the file).
##
##   Upload an old iroffer.config as the config file and the bot migrates it:
##   it is renamed *.bak and a working dinoga.config is written on start.
##############################################################################

# ==============================================================================
# hotio container / VPN (consumed by the container, not the bot)
# ==============================================================================
IMAGE_NAME=ghcr.io/jenga201/dinoga
IMAGE_TAG=noblevpn
CONTAINER_NAME=dinoga

PUID=1000
PGID=1000
TZ=Etc/UTC
UMASK=002

CONFIG_DIR=./config
DATA_DIR=./files
CONTROL_PORT=30000

# --- VPN (uncomment only on the VPN instance) ---
# VPN_ENABLED=true
# VPN_CONF=wg0
# VPN_PROVIDER=pia                 # pia | proton | generic
# VPN_AUTO_PORT_FORWARD=true
# VPN_PORT_REDIRECTS=30000/tcp     # provider forwarded port -> control port
# VPN_PIA_USER=
# VPN_PIA_PASS=
# VPN_PIA_PREFERRED_REGION=

# ==============================================================================
# per-instance bot overrides (env wins over dinoga.config)
# Any dinoga.config directive can be overridden as IROFFER_<DIRECTIVE>.
# ==============================================================================

# --- network (overrides the config file's `network { ... }` block) ---
IROFFER_NETWORK_COUNT=1
IROFFER_NETWORK_1_NAME=rizon
IROFFER_NETWORK_1_SERVER=irc.rizon.net 9999
IROFFER_NETWORK_1_CONNECTIONMETHOD=ssl
IROFFER_NETWORK_1_USER_NICK=dinoga          # per-instance nick (dinoga / dinoga-vpn)
IROFFER_NETWORK_1_CHANNEL=#frog

# --- serve mode ---
# OPEN instance (classic XDCC + SXDCC, ports published):
# IROFFER_USENATIP=2.31.76.192
# IROFFER_XDCC_ENABLE=yes
# IROFFER_TCPRANGESTART=30001
# IROFFER_TCPRANGELIMIT=30010

# VPN instance (SXDCC only, single forwarded port) — use instead:
IROFFER_XDCC_ENABLE=no

# --- commonly overridden (optional; see sample.config / --print-config) ---
# IROFFER_FILEDIR=/data
# IROFFER_SLOTSMAX=3
# IROFFER_QUEUESIZE=100
# IROFFER_ADMINPASS=
# IROFFER_HTTP_PORT=0