##############################################################################
## dinoga docker environment (copy to .env)
##
## The bot reads its configuration from /config/dinoga.config — see sample.config
## for the file's directive surface. This .env carries ONLY the per-instance
## deltas that differ from the common config file:
##
##   VPN_*     consumed by hotio/base (the container), NOT the bot.
##   IROFFER_* override the same directive in dinoga.config (env wins).
##
## The two testing instances share one dinoga.config; only the values below
## differ (open vs VPN serve mode + the VPN creds).
##############################################################################

# ==============================================================================
# hotio container / VPN
# ==============================================================================
IMAGE_NAME=ghcr.io/jenga201/dinoga
IMAGE_TAG=noblevpn
CONTAINER_NAME=dinoga

PUID=1000
PGID=1000
TZ=Etc/UTC

CONFIG_DIR=./config
DATA_DIR=./files
CONTROL_PORT=30000

# --- VPN (set these only on the VPN instance) ---
# VPN_ENABLED=true
# VPN_PROVIDER=pia                 # pia | proton | generic
# VPN_AUTO_PORT_FORWARD=true       # request a forwarded port
# VPN_PORT_REDIRECTS=30000/tcp     # forward the provider port to the control port
# VPN_PIA_USER=
# VPN_PIA_PASS=
# VPN_PIA_PREFERRED_REGION=

# ==============================================================================
# per-instance bot overrides (env wins over dinoga.config)
# ==============================================================================

# --- OPEN instance (classic XDCC + SXDCC, ports published) ---
# IROFFER_USENATIP=2.31.76.192     # public IP advertised for DCC/SXDCC
# IROFFER_XDCC_ENABLE=yes          # classic XDCC enabled
# IROFFER_TCPRANGESTART=30001      # classic DCC ports (disjoint from control_port)
# IROFFER_TCPRANGELIMIT=30010

# --- VPN instance (SXDCC only, single forwarded port) ---
# (uncomment these instead of the OPEN block, and VPN_ENABLED=true above)
# IROFFER_XDCC_ENABLE=no           # classic XDCC/DCC disabled

# Any other directive can also be set here as IROFFER_<DIRECTIVE> to override
# the config file; the canonical list is in config.Write / sample.config.